{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit-v2.local/schemas/document.json",
  "title": "Document",
  "description": "Audit document record — persisted in Postgres.",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^doc_[0-9A-Za-z]{16,26}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "source_uri": {
      "type": "string",
      "format": "uri"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "doc_type": {
      "type": "string",
      "enum": ["invoice", "purchase_order", "delivery_challan", "goods_receipt_note", "contract", "letter"]
    },
    "doc_type_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "batch_id": {
      "type": "string",
      "pattern": "^batch_[0-9A-Za-z]{8,}$"
    },
    "ingestion_run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8}-[0-9]{3}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "RECEIVED", "VALIDATED", "SCANNED", "RENDERED", "EXTRACTED",
        "NORMALIZED", "READY", "PENDING", "FAILED", "QUARANTINED",
        "QUARANTINED_SECURITY", "INCOMPLETE"
      ]
    },
    "extractor_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "coverage": {
      "$ref": "coverage.json"
    },
    "pii_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["name", "address", "tax_id", "bank_details", "email", "phone"]
      }
    },
    "residency_region": {
      "type": "string"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    }
  },
  "required": [
    "document_id", "tenant_id", "content_hash", "doc_type", "status",
    "page_count", "coverage", "received_at", "schema_version"
  ]
}
