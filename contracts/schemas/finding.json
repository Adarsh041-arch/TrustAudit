{
  "$defs": {
    "EvidenceItem": {
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "raw": {
          "title": "Raw",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "page",
        "field",
        "raw"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "FindingStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "SKIPPED",
        "NEEDS_REVIEW",
        "NOT_APPLICABLE",
        "NOT_RUN",
        "ERROR"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "properties": {
    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "check_id": {
      "title": "Check Id",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/FindingStatus"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "expected": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected"
    },
    "actual": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual"
    },
    "delta": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delta"
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "tolerance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tolerance"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "coverage": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Coverage",
      "type": "object"
    },
    "decision_fingerprint": {
      "title": "Decision Fingerprint",
      "type": "string"
    },
    "ruleset_version": {
      "title": "Ruleset Version",
      "type": "string"
    },
    "requires_human_review": {
      "default": false,
      "title": "Requires Human Review",
      "type": "boolean"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "finding_id",
    "check_id",
    "document_id",
    "tenant_id",
    "status",
    "severity",
    "message",
    "decision_fingerprint",
    "ruleset_version"
  ],
  "title": "Finding",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit-v2.local/schemas/finding.json"
}
