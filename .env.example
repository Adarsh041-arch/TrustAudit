# Audit V2 local document vision (Qwen/Ollama default; GLM remains selectable)
QWEN_VL_BASE_URL=http://127.0.0.1:11434
QWEN_VL_MODEL=qwen2.5vl:3b
QWEN_VL_TIMEOUT=120
QWEN_VL_MAX_RETRIES=1
QWEN_VL_TRANSCRIPTION_MAX_TOKENS=4096
QWEN_VL_STRUCTURED_MAX_TOKENS=1536
QWEN_VL_CONTEXT_LENGTH=4096
QWEN_VL_MAX_IMAGE_EDGE=1200
QWEN_VL_CACHE_TTL_SECONDS=3600
QWEN_VL_CACHE_MAX_PAGES=256

# Optional llama.cpp GLM-OCR fallback
GLM_OCR_BASE_URL=http://127.0.0.1:8080/v1
GLM_OCR_MODEL=models/GLM-OCR-Q8_0.gguf
GLM_OCR_TIMEOUT=120
GLM_OCR_MAX_RETRIES=1
GLM_OCR_TRANSCRIPTION_MAX_TOKENS=4096
GLM_OCR_STRUCTURED_MAX_TOKENS=1536
GLM_OCR_CACHE_TTL_SECONDS=3600
GLM_OCR_CACHE_MAX_PAGES=256
V2_EXTRACTION_POLICY=balanced
V2_CROSS_CHECK_MODE=on_review
V2_SUMMARY_MODE=deterministic
V2_CPU_PREPROCESS_WORKERS=2
V2_VISION_BACKEND=qwen_ollama

# Optional presentation-only summaries, cross-checks, and Auditor Copilot.
# NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct

# Persistent audit sessions and layer traces
AUDIT_SESSION_DB=.data/audit_sessions.sqlite3
AUDIT_STORE_ORIGINALS=true

# Reliability release control: only enable after holdout and recovery gates pass.
V2_AUTO_CLEARANCE_ENABLED=false
V2_AUTH_MODE=local
# Token mode accounts contain server-owned identities and SHA256 token digests.
# V2_AUTH_ACCOUNTS=[{"actor_id":"reviewer1","tenant_id":"tenant1","role":"reviewer","token_sha256":"SHA256_OF_RANDOM_TOKEN"}]
V2_OPERATIONAL_DB=.data/operational.sqlite3
V2_PERSISTENCE=sqlite
V2_JOB_BACKEND=local
V2_ARTIFACT_ROOT=.data/artifacts
# Shared deployments require Postgres, Temporal and shared object storage.
# V2_PERSISTENCE=postgres
# AUDIT_PG_DSN=postgresql://APP_ROLE:PASSWORD@HOST/audit
# V2_JOB_BACKEND=temporal
# TEMPORAL_HOST=localhost:7233
# V2_ARTIFACT_BUCKET=trust-audit-artifacts
# V2_S3_ENDPOINT=https://your-object-store
